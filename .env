# Tap or Trap! — build-time release configuration.
# These are public, non-secret VITE_* values read by src/lib/appConfig.ts.

VITE_APP_NAME="Tap or Trap!"
VITE_APP_VERSION=1.0.0
VITE_APP_BUILD=1

# Support + privacy are hosted by this project itself (see src/routes/support.tsx
# and src/routes/privacy.tsx). These URLs go live the moment the project is published.
VITE_SUPPORT_URL=https://project--b5f0e44c-e102-455f-ab4b-beafda78f33a.lovable.app/support
VITE_PRIVACY_URL=https://project--b5f0e44c-e102-455f-ab4b-beafda78f33a.lovable.app/privacy
VITE_PRIVACY_EFFECTIVE_DATE=2026-07-30

# PLACEHOLDER — swap this for a real, monitored inbox before submitting to App Review.
VITE_SUPPORT_EMAIL=support@taportrap.app

# Optional. Fill in once the App Store listing exists so shared scores include a link.
VITE_APP_STORE_URL=
